<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects | W13 Group</title>
    <!-- Graphie font loaded via @font-face below -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>document.documentElement.className = document.documentElement.className.replace("no-js", "js");</script>
    <style>
        /* ===== GRAPHIE FONT ===== */
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-Thin.otf') format('opentype'); font-weight: 100; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-ThinItalic.otf') format('opentype'); font-weight: 100; font-style: italic; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-ExtraLight.otf') format('opentype'); font-weight: 200; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-ExtraLightItalic.otf') format('opentype'); font-weight: 200; font-style: italic; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-Light.otf') format('opentype'); font-weight: 300; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-LightItalic.otf') format('opentype'); font-weight: 300; font-style: italic; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-Book.otf') format('opentype'); font-weight: 350; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-BookItalic.otf') format('opentype'); font-weight: 350; font-style: italic; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-Regular.otf') format('opentype'); font-weight: 400; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-Italic.otf') format('opentype'); font-weight: 400; font-style: italic; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-SemiBold.otf') format('opentype'); font-weight: 600; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-SemiBoldItalic.otf') format('opentype'); font-weight: 600; font-style: italic; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-Bold.otf') format('opentype'); font-weight: 700; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-BoldItalic.otf') format('opentype'); font-weight: 700; font-style: italic; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-ExtraBold.otf') format('opentype'); font-weight: 800; font-style: normal; font-display: swap; }
        @font-face { font-family: 'Graphie'; src: url('fonts/Graphie-ExtraBoldItalic.otf') format('opentype'); font-weight: 800; font-style: italic; font-display: swap; }

        /* ===== RESET ===== */
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { overflow-x: hidden; scroll-behavior: smooth; }
        body {
            font-family: 'Graphie', -apple-system, sans-serif;
            background: #0C233F;
            color: #EAEAEA;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        a { text-decoration: none; color: inherit; }
        button { cursor: pointer; border: none; font-family: inherit; background: none; color: inherit; }
        img { max-width: 100%; display: block; }
        ul { list-style: none; }
        ::selection { background: rgba(68,192,192,0.3); }

        /* ===== PRELOADER ===== */
        .preloader {
            position: fixed; inset: 0; background: #0C233F; z-index: 100000;
            display: flex; align-items: center; justify-content: center; flex-direction: column;
            transition: opacity 0.6s ease, visibility 0.6s ease;
        }
        .preloader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
        .preloader-brand {
            display: inline-flex;
            align-items: flex-end;
            gap: 12px;
        }
        .preloader-logo {
            height: 52px;
            width: auto;
            opacity: 0;
            transform: translateY(12px) scale(0.98);
            animation: preloaderLogoIn 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
        }
        .preloader-brand-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #44C0C0;
            margin-bottom: 6px;
            opacity: 0;
            transform: scale(0.2);
            box-shadow: 0 0 0 0 rgba(68,192,192,0.45);
            animation:
                preloaderDotIn 0.55s ease 0.45s forwards,
                preloaderDotPulse 1.2s ease-in-out 1s infinite;
        }
        @keyframes preloaderLogoIn {
            0% { opacity: 0; transform: translateY(12px) scale(0.98); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes preloaderDotIn {
            0% { opacity: 0; transform: scale(0.2) translateX(-4px); }
            100% { opacity: 1; transform: scale(1) translateX(0); }
        }
        @keyframes preloaderDotPulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(68,192,192,0.45); }
            50% { transform: scale(1.12); box-shadow: 0 0 0 10px rgba(68,192,192,0); }
        }

        /* ===== NAVBAR ===== */
        .navbar {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            padding: 30px 50px;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            background: linear-gradient(to bottom, rgba(12,35,63,0.95) 0%, transparent 100%);
        }
        .nav-inner {
            max-width: 1440px; margin: 0 auto;
            display: flex; align-items: center;
        }
        .navbar.scrolled {
            background: rgba(12,35,63,0.98);
            padding: 20px 50px;
            backdrop-filter: blur(10px);
        }
        .navbar:has(.nav-dropdown:hover) {
            background: rgba(12,35,63,0.98);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        .nav-logo {
            display: flex; align-items: center;
        }
        .nav-logo img {
            height: 40px; width: auto;
        }
        .nav-center { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .nav-link {
            font-size: 16px; font-weight: 400; color: rgba(234,234,234,0.6);
            padding: 8px 16px; transition: color 0.3s; letter-spacing: 0.2px;
        }
        .nav-link:hover { color: #EAEAEA; }
        .nav-link.active { color: #EAEAEA; }
        .nav-cta {
            display: inline-flex; align-items: center; gap: 10px;
            font-size: 16px; font-weight: 400; color: #EAEAEA;
            padding: 10px 16px 10px 22px;
            border: 1.5px solid rgba(68,192,192,0.9);
            border-radius: 50px; transition: all 0.3s;
            letter-spacing: 0.2px; white-space: nowrap;
        }
        .nav-cta:hover { background: rgba(68,192,192,0.12); }
        .nav-cta-dot {
            width: 32px; height: 32px; background: #44C0C0; border-radius: 50%;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .nav-cta-dot svg { width: 16px; height: 16px; }
        .mobile-menu-btn {
            display: none; font-size: 15px; font-weight: 500; color: #EAEAEA;
            letter-spacing: 2px; text-transform: uppercase; cursor: pointer;
            align-items: center; gap: 12px;
        }
        .mobile-menu-lines { display: flex; flex-direction: column; gap: 5px; width: 24px; }
        .mobile-menu-lines span {
            height: 1.5px; background: #EAEAEA; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .mobile-menu-lines span:first-child { width: 24px; }
        .mobile-menu-lines span:last-child { width: 16px; }
        /* ===== MEGA MENU ===== */
        .nav-dropdown { position: static; }
        .nav-dropdown > .nav-link,
        .nav-dropdown > .top-nav-link { position: relative; cursor: pointer; }
        .nav-dropdown:hover > .nav-link,
        .nav-dropdown:hover > .top-nav-link {
            text-decoration: underline;
            text-underline-offset: 4px;
            text-decoration-thickness: 1.5px;
        }
        .nav-dropdown:hover > .nav-link::after,
        .nav-dropdown:hover > .top-nav-link::after {
            content: '';
            position: absolute;
            left: 4px;
            top: 50%;
            transform: translateY(-50%);
            width: 8px;
            height: 8px;
            background: #44C0C0;
            border-radius: 50%;
            animation: megaDotPop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        @keyframes megaDotPop {
            0% { transform: translateY(-50%) scale(0); }
            100% { transform: translateY(-50%) scale(1); }
        }
        .mega-menu {
            position: absolute;
            top: calc(100% - 40px);
            left: 50%;
            transform: translateX(-50%) translateY(-8px);
            width: calc(100% - 80px);
            max-width: 1440px;
            padding-top: 40px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 1001;
            pointer-events: none;
        }
        .nav-dropdown:hover .mega-menu {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
            pointer-events: auto;
        }
        .mega-menu-content {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr 1.4fr;
            background: #fff;
            border-radius: 16px 16px 4px 4px;
            overflow: hidden;
            border-bottom: 4px solid #44C0C0;
            box-shadow: 0 25px 60px rgba(12,35,63,0.18);
        }
        .mega-menu-intro { padding: 48px 40px; }
        .mega-menu-title {
            font-family: 'Graphie', sans-serif; font-weight: 600;
            font-size: 52px;
            font-weight: 400;
            color: #0C233F;
            margin-bottom: 24px;
            line-height: 1.1;
        }
        .mega-menu-desc {
            font-size: 15px;
            line-height: 1.75;
            color: rgba(12,35,63,0.55);
        }
        .mega-menu-links {
            padding: 48px 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .mega-menu-links a {
            display: block;
            padding: 16px 0;
            font-size: 16px;
            color: #0C233F;
            border-bottom: 1px dotted rgba(12,35,63,0.2);
            transition: color 0.25s;
            text-decoration: none;
        }
        .mega-menu-links a:last-child { border-bottom: none; }
        .mega-menu-links a:hover { color: #44C0C0; }
        .mega-menu-image {
            position: relative;
            overflow: hidden;
            min-height: 350px;
        }
        .mega-menu-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            transition: transform 0.6s ease;
        }
        .mega-menu-content:hover .mega-menu-image img {
            transform: scale(1.05);
        }

        /* ===== FULLSCREEN MENU ===== */
        .fullscreen-menu {
            position: fixed; inset: 0; background: #0C233F; z-index: 9999;
            display: flex; opacity: 0; pointer-events: none;
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .fullscreen-menu.active { opacity: 1; pointer-events: all; }
        .menu-close {
            position: absolute; top: 30px; right: 50px; font-size: 15px; font-weight: 500;
            color: #EAEAEA; letter-spacing: 2px; text-transform: uppercase; cursor: pointer;
            display: flex; align-items: center; gap: 12px; z-index: 10;
        }
        .menu-close-x { font-size: 28px; font-weight: 300; line-height: 1; }
        .menu-left {
            flex: 1; display: flex; flex-direction: column; justify-content: center;
            padding: 100px 80px;
            position: relative;
            z-index: 20;
            overflow: visible;
        }
        .menu-nav-link {
            display: block; font-family: 'Graphie', sans-serif; font-weight: 600;
            font-size: clamp(36px, 5vw, 60px); font-weight: 600; color: #EAEAEA;
            padding: 12px 0; opacity: 0.4; transition: all 0.32s; position: relative;
            transform: translateX(-20px); line-height: 1.2;
        }
        .fullscreen-menu.active .menu-nav-link {
            transform: translateX(0);
            transition-delay: calc(var(--i) * 0.08s);
        }
        .menu-nav-link:hover { opacity: 1; padding-left: 30px; }
        .menu-nav-link::before {
            content: ''; position: absolute; left: 0; top: 50%; width: 0; height: 1px;
            background: #44C0C0; transition: width 0.3s;
        }
        .menu-nav-link:hover::before { width: 20px; }
        .menu-dropdown {
            position: relative;
            display: inline-block;
            overflow: visible;
            transform: translateX(-20px);
            transition: transform 0.4s;
        }
        .fullscreen-menu.active .menu-dropdown {
            transform: translateX(0);
            transition-delay: calc(var(--i) * 0.08s);
        }
        .menu-dropdown > .menu-nav-link {
            list-style: none;
            cursor: pointer;
        }
        .menu-dropdown summary::-webkit-details-marker { display: none; }
        .menu-submenu {
            position: absolute;
            left: clamp(250px, 31vw, 390px);
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 6px;
            width: min(380px, 30vw);
            max-width: 0;
            padding: 20px 0 20px 0;
            border-left: 1px solid transparent;
            background: rgba(12,35,63,0.16);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            clip-path: inset(0 100% 0 0);
            transition: opacity 0.24s ease, max-width 0.28s cubic-bezier(0.16, 1, 0.3, 1), clip-path 0.24s ease, visibility 0.24s;
            transition-delay: 0s, 0s, 0s, 0s;
            z-index: 30;
        }
        .fullscreen-menu.menu-ready .menu-dropdown:hover .menu-submenu,
        .fullscreen-menu.menu-ready .menu-dropdown > .menu-nav-link:hover + .menu-submenu,
        .fullscreen-menu.menu-ready .menu-dropdown:focus-within .menu-submenu {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            max-width: min(380px, 30vw);
            clip-path: inset(0 0 0 0);
            transition-delay: 0.32s, 0.32s, 0.32s, 0.32s;
            border-left-color: rgba(67,192,192,0.18);
        }
        .menu-sub-link {
            font-family: 'Graphie', sans-serif; font-weight: 600;
            font-size: clamp(21px, 1.6vw, 28px);
            line-height: 1.14;
            font-weight: 600;
            color: rgba(234,234,234,0.7);
            letter-spacing: 0.1px;
            padding: 6px 0 6px 26px;
            white-space: nowrap;
            transition: color 0.25s ease, transform 0.25s ease, opacity 0.25s ease;
        }
        .menu-sub-link:hover {
            color: #EAEAEA;
            transform: translateX(6px);
        }
        @media (max-width: 900px) {
            .menu-dropdown { width: 100%; display: block; }
            .menu-submenu {
                position: static;
                transform: none;
                margin: 6px 0 0 28px;
                width: auto;
                max-width: none;
                padding: 0;
                border: 0;
                background: transparent;
                overflow: visible;
                clip-path: none;
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }
            .menu-sub-link {
                font-size: 16px;
                font-family: 'Graphie', sans-serif;
                font-weight: 500;
                color: rgba(234,234,234,0.6);
                padding-left: 0;
                white-space: normal;
            }
        }
        .menu-right {
            width: 45%; position: relative; overflow: hidden;
            display: flex; align-items: flex-end; padding: 60px;
            z-index: 5;
        }
        .menu-right-img {
            position: absolute; inset: 0;
        }
        .menu-right-img img { width: 100%; height: 100%; object-fit: cover; opacity: 0.4; }
        .menu-right-info { position: relative; z-index: 2; }
        .menu-right-info h4 {
            font-size: 13px; font-weight: 600; letter-spacing: 3px;
            text-transform: uppercase; color: #44C0C0; margin-bottom: 16px;
        }
        .menu-right-info p {
            font-size: 15px; color: rgba(234,234,234,0.6); line-height: 1.7;
        }
        .menu-right-info a {
            display: inline-block; margin-top: 16px; font-size: 14px; color: #44C0C0;
            font-weight: 500; border-bottom: 1px solid rgba(68,192,192,0.4);
            padding-bottom: 2px; transition: border-color 0.3s;
        }
        .menu-right-info a:hover { border-color: #44C0C0; }

        /* ===== PAGE HERO ===== */
        .page-hero {
            padding: 130px 50px 40px;
            background: #0C233F;
        }
        .page-hero-content {
            max-width: 1400px;
            margin: 0 auto;
        }
        .page-hero-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: rgba(68,192,192,0.75);
            margin-bottom: 14px;
        }
        .page-hero-title {
            font-family: 'Graphie', sans-serif; font-weight: 600;
            font-size: clamp(44px, 6.5vw, 84px);
            font-weight: 700;
            line-height: 1.1;
            color: #EAEAEA;
            margin-bottom: 0;
            position: relative;
            padding-bottom: 28px;
        }
        .page-hero-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 48px;
            height: 3px;
            background: #44C0C0;
            border-radius: 2px;
        }

        /* ===== PROJECTS GRID ===== */
        .projects-grid-section {
            padding: 30px 50px 110px;
            background: #0C233F;
        }
        .projects-grid-inner {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ===== FILTER MODAL ===== */
        .filter-modal {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            margin-bottom: 40px;
            padding: 6px 0;
        }
        .filters {
            display: flex;
            gap: 22px;
            flex-wrap: wrap;
        }
        .filters_group {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
        }
        .group_option {
            display: flex;
            align-items: center;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            color: rgba(234,234,234,0.45);
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: color 0.3s, border-color 0.3s, background 0.3s;
            user-select: none;
            padding: 8px 16px;
            border-radius: 50px;
            border: 1px solid transparent;
        }
        .group_option input[type="radio"] {
            display: none;
        }
        .group_option input[type="radio"]:checked + .option-label,
        .group_option:has(input[type="radio"]:checked) {
            color: #44C0C0;
            border-color: rgba(68,192,192,0.4);
            background: rgba(68,192,192,0.08);
        }
        .group_option:hover {
            color: rgba(234,234,234,0.8);
        }
        .filter-toggle-btn {
            font-size: 14px;
            font-weight: 600;
            color: #44C0C0;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 12px 24px;
            border: 1px solid rgba(68,192,192,0.3);
            transition: all 0.3s;
        }
        .filter-toggle-btn:hover {
            background: rgba(68,192,192,0.1);
        }

        /* ===== MASONRY GRID ===== */
        .projects-container {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
            grid-auto-flow: dense;
        }
        
        .project-item {
            position: relative;
            overflow: hidden;
            cursor: pointer;
            display: block;
            height: 380px;
            border-radius: 12px;
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                        box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .project-item:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        }
        
        .project-item.size-large {
            grid-row: span 2;
            height: 520px;
        }
        
        .project-item.size-wide {
            grid-column: span 2;
        }
        
        .project-item.hidden {
            display: none;
        }
        
        .item_image {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        .project-item:hover .item_image {
            transform: scale(1.05);
        }
        
        .item_content {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(12,35,63,0.85) 0%, rgba(12,35,63,0.2) 40%, transparent 65%);
            display: flex;
            align-items: flex-end;
            padding: 28px;
            opacity: 1;
            transition: background 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        .project-item:hover .item_content {
            background: linear-gradient(to top, rgba(12,35,63,0.9) 0%, rgba(12,35,63,0.3) 45%, transparent 70%);
        }
        
        .item_content_inner {
            width: 100%;
        }
        
        .item_title {
            font-family: 'Graphie', sans-serif; font-weight: 600;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.25;
            color: #EAEAEA;
            margin-bottom: 8px;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .project-item:hover .item_title {
            transform: translateY(-2px);
        }
        
        .item_meta {
            font-size: 12px;
            color: rgba(68,192,192,0.85);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* ===== LOAD MORE ===== */
        .load-more-container {
            text-align: center;
            margin-top: 40px;
        }
        .load-more-btn {
            display: inline-block;
            padding: 14px 36px;
            background: transparent;
            border: 1px solid rgba(234,234,234,0.2);
            color: rgba(234,234,234,0.7);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            border-radius: 50px;
            transition: all 0.4s;
        }
        .load-more-btn:hover {
            border-color: rgba(68,192,192,0.6);
            color: #44C0C0;
            background: rgba(68,192,192,0.08);
        }
        .load-more-btn.hidden {
            display: none;
        }

        /* ===== CTA ===== */
        .cta-section {
            padding: 120px 50px;
            background: #091c33;
            border-top: 1px solid rgba(68,192,192,0.1);
        }
        .cta-inner {
            max-width: 900px;
            margin: 0 auto;
            text-align: center;
        }
        .cta-title {
            font-family: 'Graphie', sans-serif; font-weight: 600;
            font-size: clamp(40px, 6vw, 72px);
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 30px;
        }
        .cta-text {
            font-size: 18px;
            color: rgba(234,234,234,0.55);
            line-height: 1.8;
            margin-bottom: 50px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
        .btn-cta {
            display: inline-block;
            padding: 20px 50px;
            background: #44C0C0;
            color: #0C233F;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 1px;
            transition: all 0.4s;
        }
        .btn-cta:hover {
            background: #3aadad;
            transform: translateY(-2px);
        }

        /* ===== FOOTER ===== */
        .footer {
            background: #091c33;
            padding: 80px 50px 40px;
            border-top: 1px solid rgba(68,192,192,0.1);
        }
        .footer-inner {
            max-width: 1400px;
            margin: 0 auto;
        }
        .footer-top {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            gap: 60px;
            padding-bottom: 60px;
            border-bottom: 1px solid rgba(68,192,192,0.1);
        }
        .footer-logo {
            margin-bottom: 20px;
        }
        .footer-logo img {
            height: 48px;
            width: auto;
        }
        .footer-brand-text {
            font-size: 14px;
            color: rgba(234,234,234,0.4);
            line-height: 1.7;
        }
        .footer-nav {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }
        .footer-nav-col h4 {
            font-family: 'Graphie', sans-serif; font-weight: 600;
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #EAEAEA;
        }
        .footer-nav-col ul {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .footer-nav-col a {
            font-size: 14px;
            color: rgba(234,234,234,0.5);
            transition: color 0.3s;
            display: block;
        }
        .footer-nav-col a:hover {
            color: #44C0C0;
        }
        .footer-contact-heading {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #44C0C0;
            margin-bottom: 20px;
        }
        .footer-contact-text {
            font-size: 14px;
            color: rgba(234,234,234,0.4);
            line-height: 1.8;
        }
        .footer-contact-text a {
            color: rgba(234,234,234,0.6);
            transition: color 0.3s;
        }
        .footer-contact-text a:hover {
            color: #44C0C0;
        }
        .footer-social {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        .footer-social a {
            width: 40px;
            height: 40px;
            border: 1px solid rgba(68,192,192,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(234,234,234,0.4);
            font-size: 15px;
            transition: all 0.3s;
        }
        .footer-social a:hover {
            border-color: #44C0C0;
            color: #44C0C0;
        }
        .footer-bottom {
            padding-top: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        .footer-legal {
            display: flex;
            gap: 20px;
        }
        .footer-legal a {
            font-size: 12px;
            color: rgba(234,234,234,0.25);
            transition: color 0.3s;
        }
        .footer-legal a:hover {
            color: #44C0C0;
        }
        .footer-copy {
            font-size: 12px;
            color: rgba(234,234,234,0.25);
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1200px) {
            .projects-container {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
            .project-item.size-wide {
                grid-column: span 2;
            }
        }

        @media (max-width: 1024px) {
            .projects-container {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
            .project-item.size-wide {
                grid-column: span 2;
            }
            .footer-top {
                grid-template-columns: 1fr;
            }
            .menu-right {
                display: none;
            }
        }

        @media (max-width: 768px) {
            .navbar {
                padding: 20px 30px;
            }
            .nav-inner { max-width: 100%; }
            .nav-center .nav-link { display: none; }
            .nav-center .nav-dropdown { display: none; }
            .nav-cta { display: none; }
            .mobile-menu-btn { display: flex; }
            .page-hero {
                padding: 120px 30px 50px;
            }
            .projects-grid-section {
                padding: 30px 24px 80px;
            }
            .projects-container {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .project-item {
                height: 340px;
            }
            .project-item.size-large {
                height: 400px;
                grid-row: span 1;
            }
            .project-item.size-wide {
                grid-column: span 1;
            }
            .item_title {
                font-size: 20px;
            }
            .cta-section {
                padding: 80px 30px;
            }
            .footer {
                padding: 60px 30px 30px;
            }
            .footer-nav {
                grid-template-columns: 1fr;
            }
            .filters_group {
                gap: 12px;
            }
            .group_option {
                font-size: 11px;
                padding: 6px 12px;
            }
        }
    </style>
</head>
